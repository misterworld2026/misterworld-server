# Copy to .env for Docker Compose and fill in your own values.
# For IntelliJ/Gradle, inject environment variables into the run configuration.
DB_USERNAME=misterworld
DB_PASSWORD=
JWT_SECRET=
VOICE_PYTHON_READ_TIMEOUT_MS=180000
# Used when running Spring Boot directly on the host with Compose's MySQL port.
DB_URL=jdbc:mysql://localhost:3307/misterworld?characterEncoding=UTF-8
